# Public browser configuration. Use the local URL and anon key from supabase status.
# Optional for local development. Set both variables for an explicitly configured build.
# Never use a service_role/secret key in VITE_*.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Production ignores ?now= and ?seed= unless this explicit test option is enabled.
VITE_ENABLE_TEST_OVERRIDES=false
